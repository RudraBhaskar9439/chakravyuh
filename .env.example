CHAKRAVYUH_ENVIRONMENT=local
CHAKRAVYUH_LOG_LEVEL=INFO
CHAKRAVYUH_API_HOST=0.0.0.0
CHAKRAVYUH_API_PORT=8000
CHAKRAVYUH_CORS_ORIGINS=["http://localhost:3000"]
CHAKRAVYUH_TRUSTED_HOSTS=["localhost","127.0.0.1","test","testserver"]

CHAKRAVYUH_POSTGRES_DSN=postgresql+asyncpg://chakravyuh:local-development-only@localhost:5432/chakravyuh
CHAKRAVYUH_POSTGRES_POOL_SIZE=10
CHAKRAVYUH_POSTGRES_MAX_OVERFLOW=20
CHAKRAVYUH_POSTGRES_POOL_TIMEOUT_SECONDS=5
CHAKRAVYUH_POSTGRES_STATEMENT_TIMEOUT_MS=5000
CHAKRAVYUH_POSTGRES_READINESS_TIMEOUT_SECONDS=2
CHAKRAVYUH_WORKER_BATCH_SIZE=50
CHAKRAVYUH_JOURNEY_REDUCTION_BATCH_SIZE=50
CHAKRAVYUH_JOURNEY_MAX_EVENTS=10000
CHAKRAVYUH_INVARIANT_EVALUATION_BATCH_SIZE=50
CHAKRAVYUH_INVARIANT_MAX_EVENTS=10000
CHAKRAVYUH_INVARIANT_CAPTURED_ORDER_GRACE_SECONDS=300
CHAKRAVYUH_INVARIANT_AUTHORIZED_CAPTURE_GRACE_SECONDS=900
CHAKRAVYUH_INVARIANT_FAILED_RECOVERY_GRACE_SECONDS=1800
CHAKRAVYUH_INVARIANT_STALE_RECOVERY_LINK_GRACE_SECONDS=300
CHAKRAVYUH_WORKER_POLL_INTERVAL_SECONDS=1
CHAKRAVYUH_WORKER_ERROR_BACKOFF_SECONDS=5
CHAKRAVYUH_REDIS_DSN=redis://localhost:6379/0
CHAKRAVYUH_NEO4J_URI=bolt://localhost:7687
CHAKRAVYUH_NEO4J_USERNAME=neo4j
CHAKRAVYUH_NEO4J_PASSWORD=local-development-only
CHAKRAVYUH_NEO4J_DATABASE=neo4j
CHAKRAVYUH_NEO4J_CONNECTION_TIMEOUT_SECONDS=5
CHAKRAVYUH_GRAPH_PROJECTION_BATCH_SIZE=20
CHAKRAVYUH_GRAPH_PROJECTION_LEASE_SECONDS=30
CHAKRAVYUH_GRAPH_PROJECTION_MAX_FAILURES=5
CHAKRAVYUH_GRAPH_PROJECTION_RETRY_DELAY_SECONDS=2
CHAKRAVYUH_GRAPH_PROJECTION_LAG_THRESHOLD_SECONDS=60
CHAKRAVYUH_DIAGNOSIS_BATCH_SIZE=10
CHAKRAVYUH_DIAGNOSIS_LEASE_SECONDS=60
CHAKRAVYUH_DIAGNOSIS_MAX_FAILURES=5
CHAKRAVYUH_DIAGNOSIS_RETRY_DELAY_SECONDS=5
CHAKRAVYUH_DIAGNOSIS_MAX_FACTS=128
CHAKRAVYUH_DIAGNOSIS_MAX_RELATIONSHIPS=256
CHAKRAVYUH_DIAGNOSIS_MINIMUM_CONFIDENCE=0.7
CHAKRAVYUH_DIAGNOSIS_PRIMARY_PROVIDER=gemini
CHAKRAVYUH_DIAGNOSIS_FALLBACK_PROVIDER=
GEMINI_API_KEY=
CHAKRAVYUH_GEMINI_MODEL=gemini-3.5-flash
CHAKRAVYUH_GEMINI_TIMEOUT_SECONDS=30
CHAKRAVYUH_OPENROUTER_API_KEY=
CHAKRAVYUH_OPENROUTER_MODEL=google/gemini-3.5-flash-lite
CHAKRAVYUH_OPENROUTER_TIMEOUT_SECONDS=30

# Read-only operator API authentication. Map a principal name to the lowercase SHA-256 hash of a
# high-entropy bearer token. The raw token belongs only in the operator's password manager.
CHAKRAVYUH_OPERATOR_TOKEN_HASHES={}
# Assign only the scopes each principal needs: incident:read, action:propose, action:approve,
# action:execute, and metrics:read. Production requires an explicit non-empty scope set for every
# token principal and the Redis limiter below.
CHAKRAVYUH_OPERATOR_PRINCIPAL_SCOPES={}
CHAKRAVYUH_OPERATOR_REQUESTS_PER_MINUTE=120
CHAKRAVYUH_OPERATOR_AUTH_ATTEMPTS_PER_MINUTE=30
CHAKRAVYUH_RATE_LIMIT_BACKEND=memory
CHAKRAVYUH_RATE_LIMIT_PREFIX=chakravyuh:rate

# Phase 9 outbound actions are fail-closed and accept only rzp_test_ credentials. Capture is capped,
# requires a second operator, and is disabled by default even when credentials are configured.
CHAKRAVYUH_RAZORPAY_ACTIONS_ENABLED=false
CHAKRAVYUH_ACTION_PROPOSAL_TTL_SECONDS=900
CHAKRAVYUH_ACTION_EXECUTION_LEASE_SECONDS=30
CHAKRAVYUH_ACTION_RECOVERY_LINK_TTL_SECONDS=86400
CHAKRAVYUH_ACTION_MAX_CAPTURE_SUBUNITS=1000000
CHAKRAVYUH_ACTION_MINIMUM_CAPTURE_CONFIDENCE=0.9
CHAKRAVYUH_RAZORPAY_ACTION_TIMEOUT_SECONDS=10
CHAKRAVYUH_RAZORPAY_KEY_ID=
CHAKRAVYUH_RAZORPAY_KEY_SECRET=

# A separately gated, fixed-value Test Mode Checkout used only to create one real authorized
# payment for the buildathon recovery proof. It is rejected in the production environment.
CHAKRAVYUH_TEST_CHECKOUT_ENABLED=false
CHAKRAVYUH_TEST_CHECKOUT_AMOUNT_SUBUNITS=1000
CHAKRAVYUH_TEST_CHECKOUT_TTL_SECONDS=1800

# Phase 2 webhook intake. Never commit real values. Previous secrets allow safe
# rotation while Razorpay may still retry events signed with the old secret.
CHAKRAVYUH_RAZORPAY_MERCHANT_ID=merchant-local
CHAKRAVYUH_RAZORPAY_ACCOUNT_ID=
CHAKRAVYUH_RAZORPAY_WEBHOOK_SECRET=
CHAKRAVYUH_RAZORPAY_PREVIOUS_WEBHOOK_SECRETS=[]
CHAKRAVYUH_MAX_WEBHOOK_BODY_BYTES=262144

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
