CHAKRAVYUH_ENVIRONMENT=local
CHAKRAVYUH_LOG_LEVEL=INFO
CHAKRAVYUH_API_HOST=0.0.0.0
CHAKRAVYUH_API_PORT=8000
CHAKRAVYUH_CORS_ORIGINS=["http://localhost:3000"]

CHAKRAVYUH_POSTGRES_DSN=postgresql+asyncpg://chakravyuh:local-development-only@localhost:5432/chakravyuh
CHAKRAVYUH_POSTGRES_POOL_SIZE=10
CHAKRAVYUH_POSTGRES_MAX_OVERFLOW=20
CHAKRAVYUH_POSTGRES_POOL_TIMEOUT_SECONDS=5
CHAKRAVYUH_POSTGRES_STATEMENT_TIMEOUT_MS=5000
CHAKRAVYUH_POSTGRES_READINESS_TIMEOUT_SECONDS=2
CHAKRAVYUH_WORKER_BATCH_SIZE=50
CHAKRAVYUH_WORKER_POLL_INTERVAL_SECONDS=1
CHAKRAVYUH_WORKER_ERROR_BACKOFF_SECONDS=5
CHAKRAVYUH_REDIS_DSN=redis://localhost:6379/0
CHAKRAVYUH_NEO4J_URI=bolt://localhost:7687
CHAKRAVYUH_NEO4J_USERNAME=neo4j
CHAKRAVYUH_NEO4J_PASSWORD=local-development-only

# API credentials are introduced only when an outbound Razorpay adapter exists.
CHAKRAVYUH_RAZORPAY_KEY_ID=
CHAKRAVYUH_RAZORPAY_KEY_SECRET=

# Phase 2 webhook intake. Never commit real values. Previous secrets allow safe
# rotation while Razorpay may still retry events signed with the old secret.
CHAKRAVYUH_RAZORPAY_MERCHANT_ID=merchant-local
CHAKRAVYUH_RAZORPAY_ACCOUNT_ID=
CHAKRAVYUH_RAZORPAY_WEBHOOK_SECRET=
CHAKRAVYUH_RAZORPAY_PREVIOUS_WEBHOOK_SECRETS=[]
CHAKRAVYUH_MAX_WEBHOOK_BODY_BYTES=262144

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
